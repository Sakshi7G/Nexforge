{
  "name": "nexforge-server",
  "version": "1.0.0",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "start:prod": "npx prisma generate && npx prisma db push && node dist/server.js",
    "build:prod": "npm install --include=dev && tsc && npx prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:db:push": "prisma db push"
  },
  "dependencies": {
    "@google/generative-ai": "^0.17.0",
    "@prisma/client": "^5.18.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/fs-extra": "^11.0.4",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.12",
    "@types/nodemailer": "^8.0.1",
    "@types/uuid": "^10.0.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dockerode": "^4.0.2",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "fs-extra": "^11.2.0",
    "jsonwebtoken": "^9.0.2",
    "nexforge-monorepo": "file:..",
    "node-pty": "^1.1.0",
    "nodemailer": "^9.0.5",
    "simple-git": "^3.25.0",
    "socket.io": "^4.7.5",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "prisma": "^5.18.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "5.5.4"
  }
}
